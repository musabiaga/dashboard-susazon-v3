# ============================================================================
# Dashboard Comercial Susazón V4.0 — Variables de entorno
# Copia este archivo a .env.local y rellena los valores reales.
# NUNCA commitees .env.local — está en .gitignore.
# Los valores reales viven en SECRETS_DASHBOARD_V3.txt (privado) + Apple Notes.
# ============================================================================

# ----------------------------------------------------------------------------
# Supabase (auth + database)
# Obtén estos valores en: https://supabase.com/dashboard → tu proyecto → Settings → API
# ----------------------------------------------------------------------------

# URL pública del proyecto (ej. https://abcd1234.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Publishable / anon key — segura para exponer al browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — NUNCA exponer al browser. Solo para operaciones admin server-side
# (crear usuarios, escribir audit log con bypass de RLS, etc.)
SUPABASE_SERVICE_ROLE_KEY=

# ----------------------------------------------------------------------------
# API Susazón (datos comerciales)
# Llamada server-side desde Next.js API routes — la key NUNCA llega al browser
# ----------------------------------------------------------------------------

SUSAZON_API_URL=https://sasweb.susazon.mx/susazon/api_ERPPyMEDashboard/
SUSAZON_API_KEY=

# API Suve (segunda empresa del grupo). El REFRESH en vivo desde la API de Suve
# está deshabilitado (su SQL Express es lento). Los datos históricos de Suve YA
# están en la DB (sales_rows con empresa=Suve) — el dashboard los analiza con
# normalidad. Descomentar y llenar solo si TI optimiza el SQL y se reactiva el
# refresh en vivo de Suve.
# SUVE_API_URL=https://saswebsuve.susazon.mx/suve/api_ERPPyMEDashboard/
# SUVE_API_KEY=

# ----------------------------------------------------------------------------
# Sincronización automática diaria (V4.4) — Vercel Cron
# vercel.json agenda GET /api/cron/sync a las 12:00 UTC (06:00 CDMX). Vercel
# manda `Authorization: Bearer <CRON_SECRET>` automáticamente si esta variable
# existe en el proyecto (Settings → Environment Variables → Production).
# Genera un valor largo aleatorio (ej. `openssl rand -hex 32`) y pégalo SOLO
# en Vercel. Sin esta variable el cron responde 503 y Cargar Datos avisa.
# ----------------------------------------------------------------------------
# CRON_SECRET=
